@using BlazingStory.Addons.Internals
@inject NavigationManager NavigationManager

<ToolBar>
    <TabButtonGroup>
        @foreach (var settingsPage in this._SettingsPages)
        {
            <TabButton @key="settingsPage.Route" OnClick="() => this.OnClickTabButton(settingsPage.Route)" Active="this.IsActive(settingsPage.Route)">
                @settingsPage.TabCaption
            </TabButton>
        }
    </TabButtonGroup>

    <Spacer />

    <IconButton Icon="SvgIconType.CircleClose" OnClick="OnClickCloseButton" Title="Close settings page" />

</ToolBar>

<div class="settings-page-panel">
    <div class="viewport">
        <div>
            <QueryRouteView Routes="this._Routes" />
        </div>
    </div>
</div>

@code
{
    [CascadingParameter]
    public QueryRouteData? RouteData { get; set; }

    [CascadingParameter]
    internal IServiceProvider Services { get; init; } = default!;

    private IEnumerable<SettingsPageDescriptor> _SettingsPages = [];

    private IEnumerable<QueryRoute> _Routes = [];

    protected override void OnInitialized()
    {
        var addonManager = this.Services.GetRequiredService<AddonManager>();
        this._SettingsPages = addonManager.GetSettingsPages().ToArray();
        this._Routes = this._SettingsPages.Select(page => new QueryRoute("*", page.Route, page.ComponentType)).ToArray();
    }

    private void OnClickTabButton(string route)
    {
        this.NavigationManager.NavigateTo($"./?path=/settings/{route}");
    }

    private bool IsActive(string route)
    {
        return route == this.RouteData?.Parameter;
    }

    private void OnClickCloseButton()
    {
        var navService = Services.GetRequiredService<NavigationService>();
        navService.BackToLastNavigated();
    }
}